# Tieng Lang - environment template.
# Copy to .env and fill values. NEVER commit the real .env file.

# Mode: mock | local | cloud
APP_MODE=local

# Backends
ASR_BACKEND=mock            # mock | phowhisper | whisper (whisper = faster-whisper, offline)
RETRIEVAL_BACKEND=bm25      # bm25 | hybrid
LLM_BACKEND=local           # mock | gemini | groq | pateway | local
TTS_BACKEND=mock            # mock | edge (browser speech is used by default)
LLM_FALLBACK_BACKEND=mock   # fallback if the main LLM fails

# Local Whisper ASR (used when ASR_BACKEND=whisper)
WHISPER_MODEL=small         # tiny | base | small | medium | large-v3
WHISPER_DEVICE=auto         # auto | cpu | cuda

# Paths (defaults are relative to project root)
DATA_DIR=data
RESULTS_DIR=results
LOG_DIR=logs

# LLM API keys (leave empty unless using cloud backends)
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PATEWAY_API_KEY=
PATEWAY_BASE_URL=https://api.pateway.ai/v1
PATEWAY_MODEL=gpt-5.6-luna

# Vercel: create GROQ_API_KEY and/or PATEWAY_API_KEY under Project Settings
# > Environment Variables, then redeploy. The Vercel public handler only reads
# these process environment variables; it does not load this local .env file.

# LLM local backend (100% offline): any OpenAI-compatible local server.
# Ollama: https://ollama.com — one-time pull: `ollama pull <OLLAMA_MODEL>`
# On first start, start.bat auto-detects RAM/CPU/GPU/disk and overwrites
# OLLAMA_MODEL/WHISPER_MODEL/WHISPER_DEVICE/ASR_BACKEND/TTS_BACKEND to fit
# the machine. Tiers:
#   <6GB RAM        -> mock (survival)
#   6-11GB          -> qwen2.5:3b-instruct-q4_k_m + whisper base
#   11-16GB CPU     -> qwen2.5:3b-instruct-q4_k_m + whisper small
#   11-16GB + GPU   -> qwen2.5:7b-instruct-q4_k_m + whisper small
#   >=16GB + GPU    -> qwen3:8b + whisper small/medium
# LLM_BACKEND=local
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_k_m

# Privacy
DELETE_RAW_AUDIO_AFTER_SESSION=true
SAVE_TRANSCRIPTS=false
LOG_DIRECTORY=data
# Scrub PII before the query leaves the machine (cloud backends only).
# Set to false ONLY for offline eval; keep true for any real deployment.
PII_SCRUB_OUTBOUND=true
# LLM answerability classifier (classify_safe) as a second out-of-scope layer.
# Requires a real LLM backend (gemini/groq/pateway/local); set true for pilot.
USE_LLM_CLASSIFIER=false

# Limits
MAX_CONTEXT_CHARS=12000
MAX_RESPONSE_CHARS=2000
MIN_RETRIEVAL_SCORE=1.0

# Legal intake: before answering a personalized legal question, the assistant
# asks (one at a time) for the missing facts the answer depends on.
LEGAL_INTAKE=false
# Answer review: before sending the answer, the model reviews the question vs
# the answer by itself. If it finds the answer unfit, it is allowed to rewrite
# it and redo the answer process (self-correction loop), still grounded in the
# retrieved evidence. ANSWER_REVIEW_MAX_REVISIONS bounds the loop.
ANSWER_REVIEW=false
ANSWER_REVIEW_MAX_REVISIONS=2

# Hybrid retrieval gate (answerability): thresholds calibrated on the real
# corpus. RETRIEVER_RERANK=false by default (mmarco is miscalibrated for
# Vietnamese legal text; RRF ordering is already strong).
RETRIEVER_RERANK=false
RETRIEVER_GATE=bm25_dense
RETRIEVAL_BM25_GATE=12.2
RETRIEVAL_DENSE_GATE=0.88

# Edge-TTS
EDGE_TTS_VOICE=vi-VN-HoaiMyNeural
EDGE_TTS_RATE=+0%

# Official channels (PLACEHOLDERS - must be verified by the human team
# before deployment; do not use unverified numbers)
OFFICIAL_HOTLINE_LABEL=Đường dây nóng (chưa xác minh)
OFFICIAL_HOTLINE_VALUE=1900XXXX
OFFICIAL_ONE_STOP_LABEL=Bộ phận một cửa (chưa xác minh)
OFFICIAL_ONE_STOP_VALUE=Chưa có
