# Copy these settings into Streamlit Cloud > App settings > Secrets.
# Replace placeholder values with your real keys.

APP_MODE = "cloud"
LLM_BACKEND = "groq"
# Optional: leave empty, or use a different supported cloud/local backend.
LLM_FALLBACK_BACKEND = ""
GROQ_API_KEY = "paste-your-groq-api-key-here"

# Keep TTS disabled unless you also configure a TTS provider.
TTS_BACKEND = "mock"

# Optional alternatives:
# LLM_BACKEND = "gemini"
# GEMINI_API_KEY = "paste-your-gemini-api-key-here"

# Safe demo defaults.
RETRIEVAL_BACKEND = "bm25"
SAVE_TRANSCRIPTS = "false"
DELETE_RAW_AUDIO_AFTER_SESSION = "true"
PII_SCRUB_OUTBOUND = "true"
