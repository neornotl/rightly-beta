# Copy these settings into Streamlit Cloud > App settings > Secrets.
# Real GPT-5.6 Luna configuration through Pateway.
# Replace only the API key before pasting into Streamlit Secrets.
APP_MODE = "cloud"
LLM_BACKEND = "pateway"
LLM_FALLBACK_BACKEND = ""
PATEWAY_API_KEY = "paste-your-pateway-api-key-here"
PATEWAY_BASE_URL = "https://api.pateway.ai/v1"
PATEWAY_MODEL = "gpt-5.6-luna"

TTS_BACKEND = "mock"
RETRIEVAL_BACKEND = "bm25"
SAVE_TRANSCRIPTS = "false"
DELETE_RAW_AUDIO_AFTER_SESSION = "true"
PII_SCRUB_OUTBOUND = "true"
