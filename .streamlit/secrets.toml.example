# Copy these settings into Streamlit Cloud > App settings > Secrets.
# This configuration uses the local deterministic demo backend.
# No API key and no fallback backend are required.

APP_MODE = "mock"
LLM_BACKEND = "mock"
LLM_FALLBACK_BACKEND = ""

# Keep TTS disabled unless you also configure a TTS provider.
TTS_BACKEND = "mock"

# Safe demo defaults.
RETRIEVAL_BACKEND = "bm25"
SAVE_TRANSCRIPTS = "false"
DELETE_RAW_AUDIO_AFTER_SESSION = "true"
PII_SCRUB_OUTBOUND = "true"
